        "sameAs": [
          "https://linkedin.com/in/kenimo49",
          "https://qiita.com/kenimo49",
          "https://zenn.dev/kenimo49",
          "https://note.com/kenimo49",
          "https://x.com/kenimo49",
          "https://youtube.com/@Yureru-s4n",
          "https://www.amazon.co.jp/stores/author/B0GQNPRCGF",
          "https://kenimoto.dev",
          "https://kenimo49.hatenablog.com/"
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "LearningMate",
        "provider": { "@type": "Organization", "name": "合同会社 Propel-Lab" },
        "serviceType": "教育コンテンツ",
        "description": "LLM活用の教育コンテンツ企画・制作・販売"
      },
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "AI-Loop",
        "provider": { "@type": "Organization", "name": "合同会社 Propel-Lab" },
        "serviceType": "マーケティング自動化",
        "description": "SNS運用自動化・コンテンツマーケティング支援"
      },
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "AutoCrew",
        "provider": { "@type": "Organization", "name": "合同会社 Propel-Lab" },
        "serviceType": "業務自動化コンサルティング",
        "description": "LLMによる自動実行エージェント構成・業務最適化"
      },
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "KaoriQ",
        "provider": { "@type": "Organization", "name": "合同会社 Propel-Lab" },
        "serviceType": "AI駆動EC自動運用",
        "description": "LLMエージェントによるECサイトの自律運用。コンテンツ生成・SEO・LLMO・商品キュレーションを完全自動化",
        "url": "https://kaoriq.com/"
      },
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "mypcrig",
