---
import { company } from '../data/company';
---

<section id="contact" class="py-24 lg:py-32 bg-charcoal grain-overlay grain-overlay-dark relative overflow-hidden">
  <!-- Blueprint grid on dark -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(139, 105, 20, 0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 105, 20, 0.5) 1px, transparent 1px); background-size: 48px 48px;"></div>

  <!-- Decorative corner -->
  <div class="absolute top-8 right-8 w-16 h-16 border-t border-r border-gold/15 hidden lg:block"></div>
  <div class="absolute bottom-8 left-8 w-16 h-16 border-b border-l border-gold/15 hidden lg:block"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-12 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left: Header text -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3 mb-4 fade-in-up">
          <div class="w-8 h-px bg-gold"></div>
          <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">Contact</span>
        </div>
        <h2 class="text-3xl lg:text-4xl font-bold text-cream mb-4 fade-in-up stagger-1">お問い合わせ</h2>
        <p class="text-dim text-base leading-relaxed fade-in-up stagger-2">
          事業内容に関するご質問、コンサルティングのご相談など、お気軽にお問い合わせください。
        </p>
        <p class="text-faint/50 text-xs font-mono mt-4 tracking-wider fade-in-up stagger-3">企業様はメール、カジュアルなご相談はDMでもお気軽にどうぞ</p>
      </div>

      <!-- Right: Contact actions -->
      <div class="lg:col-span-7 lg:pl-8">
        <div class="space-y-4 fade-in-up stagger-3">
          <!-- Email -->
          <a
            href={`mailto:${company.email}`}
            class="group flex items-center gap-6 p-6 border border-cream/8 hover:border-gold/30 transition-all duration-300 hover:bg-cream/3"
          >
            <div class="w-10 h-10 flex items-center justify-center border border-cream/15 group-hover:border-gold/40 transition-colors">
              <svg class="w-4 h-4 text-cream/60 group-hover:text-gold transition-colors" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path></svg>
            </div>
            <div class="flex-1">
              <div class="text-cream text-sm font-medium mb-0.5">メールで問い合わせ</div>
              <div class="text-dim text-xs font-mono">{company.email}</div>
            </div>
            <span class="text-dim group-hover:text-gold text-sm font-mono transition-colors">→</span>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/kenimo49"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-6 p-6 border border-cream/8 hover:border-gold/30 transition-all duration-300 hover:bg-cream/3"
          >
            <div class="w-10 h-10 flex items-center justify-center border border-cream/15 group-hover:border-gold/40 transition-colors">
              <svg class="w-4 h-4 text-cream/60 group-hover:text-gold transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </div>
            <div class="flex-1">
              <div class="text-cream text-sm font-medium mb-0.5">LinkedIn DM</div>
              <div class="text-dim text-xs font-mono">in/kenimo49</div>
            </div>
            <span class="text-dim group-hover:text-gold text-sm font-mono transition-colors">→</span>
          </a>

          <!-- X -->
          <a
            href="https://x.com/kenimo49"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-6 p-6 border border-cream/8 hover:border-gold/30 transition-all duration-300 hover:bg-cream/3"
          >
            <div class="w-10 h-10 flex items-center justify-center border border-cream/15 group-hover:border-gold/40 transition-colors">
              <svg class="w-4 h-4 text-cream/60 group-hover:text-gold transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </div>
            <div class="flex-1">
              <div class="text-cream text-sm font-medium mb-0.5">X DM</div>
              <div class="text-dim text-xs font-mono">@kenimo49</div>
            </div>
            <span class="text-dim group-hover:text-gold text-sm font-mono transition-colors">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
