---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { caseMeta, changelog, series, projection, actionResults } from '../data/legacydram-pilot';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const samplePdf = `${base}files/llmo-audit-sample-legacydram.pdf`;

const metrics = [series.llmoScore, series.blogListScore, series.gscIndexed, series.gscImpressions, series.aiCitationRate];

const changelogDot: Record<string, string> = {
  diagnosis: 'bg-gold',
  improvement: 'bg-emerald-400',
  measurement: 'bg-sky-400',
  milestone: 'bg-cream/40',
};
const changelogTag: Record<string, string> = {
  diagnosis: '診断',
  improvement: '改善実施',
  measurement: '再計測',
  milestone: 'マイルストーン',
};

const verdictStyle: Record<string, { label: string; cls: string }> = {
  pending: { label: '結果待ち', cls: 'border-charcoal/15 text-dim' },
  done: { label: '実施済み', cls: 'border-sky-600/40 text-sky-700 bg-sky-50' },
  positive: { label: '効果あり', cls: 'border-emerald-600/40 text-emerald-700 bg-emerald-50' },
  slight: { label: '微増', cls: 'border-amber-600/40 text-amber-700 bg-amber-50' },
  none: { label: '効果なし', cls: 'border-red-500/40 text-red-600 bg-red-50' },
};
---

<Layout
  title="公開ケーススタディ Case #001 legacydram.com — LLMO診断パイロット | Propel-Lab"
  description="Propel-Lab が自社運営メディア legacydram.com を題材に、LLMO診断→改善→効果を公開で追跡するケーススタディ。更新履歴・先行指標の実測時系列・AI引用率の想定と実測・施策ごとの結果（効果がなかったものも含む）を公開します。"
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative pt-36 pb-20 lg:pt-44 lg:pb-24 bg-charcoal grain-overlay grain-overlay-dark overflow-hidden">
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(139, 105, 20, 0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 105, 20, 0.5) 1px, transparent 1px); background-size: 48px 48px;"></div>
      <div class="mx-auto max-w-5xl px-6 lg:px-12 relative z-10">
        <div class="flex items-center gap-3 mb-5 fade-in-up">
          <div class="w-8 h-px bg-gold"></div>
          <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">Public Case Study · {caseMeta.title}</span>
        </div>
        <h1 class="text-3xl lg:text-5xl font-bold text-cream leading-tight mb-6 fade-in-up stagger-1">
          診断する側が、<br />自分のサイトで証明する。
        </h1>
        <p class="text-dim text-base leading-[1.9] max-w-3xl fade-in-up stagger-2">
          自社運営メディア <strong class="text-cream">legacydram.com</strong> を診断し、提示した改善を実装しながら、その経過を公開で追跡するケーススタディです。先行指標の実測、施策ごとの結果、そして AI引用率 0% という不都合な数字も含めて、すべて実データで残します。<strong class="text-cream">効果がなかった施策も、そのまま公開します。</strong>
        </p>
        <div class="mt-6 font-mono text-xs text-faint/50 fade-in-up stagger-3">
          baseline: {caseMeta.baselineDate}　/　last updated: {caseMeta.lastUpdated}　/　現在フェーズ: 改善実装前（baseline記録）
        </div>
      </div>
    </section>

    <!-- 更新履歴 -->
    <section class="py-20 lg:py-28 bg-charcoal grain-overlay grain-overlay-dark relative">
      <div class="mx-auto max-w-5xl px-6 lg:px-12 relative z-10">
        <div class="flex items-center gap-3 mb-10 fade-in-up">
          <div class="w-8 h-px bg-gold"></div>
          <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">Changelog</span>
          <span class="text-cream text-sm font-bold ml-1">更新履歴</span>
        </div>
        <div class="relative pl-8 lg:pl-10">
          <div class="absolute left-[7px] lg:left-[9px] top-2 bottom-2 w-px bg-cream/15"></div>
          <div class="space-y-7">
            {changelog.slice().reverse().map((c) => (
              <div class="relative fade-in-up">
                <div class={`absolute -left-8 lg:-left-10 top-1 w-3.5 h-3.5 rounded-full ring-4 ring-charcoal ${changelogDot[c.type] ?? 'bg-cream/40'}`}></div>
                <div class="flex flex-wrap items-center gap-3 mb-1">
                  <span class="font-mono text-sm text-cream font-bold">{c.date}</span>
                  <span class="font-mono text-[10px] tracking-wide uppercase text-gold/80 border border-gold/30 px-2 py-0.5">{changelogTag[c.type] ?? c.type}</span>
                </div>
                <p class="text-dim text-sm leading-relaxed">{c.event}</p>
              </div>
            ))}
            <div class="relative">
              <div class="absolute -left-8 lg:-left-10 top-1 w-3.5 h-3.5 rounded-full ring-4 ring-charcoal bg-cream/10 border border-dashed border-cream/30"></div>
              <p class="text-faint/50 text-xs font-mono">次のイベント（P0実施・再計測・被リンク施策…）をここに追記していきます</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- baseline 構造 -->
    <section class="py-20 lg:py-28 bg-cream grain-overlay relative">
      <div class="mx-auto max-w-5xl px-6 lg:px-12 relative z-10">
        <h2 class="text-2xl lg:text-3xl font-bold text-charcoal mb-3 fade-in-up">baseline が示す構造</h2>
        <p class="text-mid text-sm leading-[1.9] max-w-3xl mb-10 fade-in-up stagger-1">
          技術基板は競合を上回るのに、AIには引用されていない——legacydram の baseline は、LLMOの本質を一言で表しています。
        </p>
        <div class="grid sm:grid-cols-3 border border-charcoal/10 fade-in-up stagger-2">
          <div class="bg-charcoal text-center px-5 py-8 border-b sm:border-b-0 sm:border-r border-cream/10">
            <div class="text-5xl font-bold text-emerald-300 mb-2">93</div>
            <div class="text-cream text-sm font-bold mb-1">LLMO基板スコア</div>
            <div class="text-dim text-xs">競合4サイト中1位（競合平均50）</div>
          </div>
          <div class="bg-charcoal text-center px-5 py-8 border-b sm:border-b-0 sm:border-r border-cream/10">
            <div class="text-5xl font-bold text-red-300 mb-2">0%</div>
            <div class="text-cream text-sm font-bold mb-1">AI引用率</div>
            <div class="text-dim text-xs">専用記事を持つクエリで被引用ゼロ</div>
          </div>
          <div class="bg-charcoal text-center px-5 py-8">
            <div class="text-5xl font-bold text-red-300 mb-2">2</div>
            <div class="text-cream text-sm font-bold mb-1">外部被リンク（90日）</div>
            <div class="text-dim text-xs">権威性の天井・改善の主戦場</div>
          </div>
        </div>
        <p class="mt-6 text-mid text-sm leading-relaxed fade-in-up stagger-3">
          診断の全文（16ページ）は
          <a href={samplePdf} target="_blank" class="text-gold-muted border-b border-gold/40 hover:border-gold pb-0.5">サンプルレポートPDF</a>
          で公開しています。
        </p>
      </div>
    </section>

    <!-- 先行指標の実測時系列 -->
    <section class="py-20 lg:py-28 bg-sand grain-overlay blueprint-grid relative">
      <div class="mx-auto max-w-5xl px-6 lg:px-12 relative z-10">
        <div class="mb-12 max-w-2xl">
          <div class="flex items-center gap-3 mb-4 fade-in-up">
            <div class="w-8 h-px bg-gold"></div>
            <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">Measured · Leading Indicators</span>
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-charcoal mb-4 fade-in-up stagger-1">先行指標（実測）</h2>
          <p class="text-mid text-base leading-relaxed fade-in-up stagger-2">
            改善実装で早く動く指標を実測で追います。すべて測定値で、推定は含みません。
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {metrics.map((m) => {
            const pts = m.points;
            const latest = pts[pts.length - 1];
            const first = pts[0];
            const pct = Math.min(100, Math.round((latest.value / m.max) * 100));
            const delta = pts.length > 1 ? latest.value - first.value : null;
            return (
              <div class="bg-parchment border border-charcoal/8 p-7 lg:p-8 fade-in-up">
                <div class="text-sm font-bold text-charcoal mb-1">{m.label}</div>
                <div class="flex items-baseline gap-3 mb-4">
                  <span class="text-4xl font-bold text-charcoal">{latest.value}{m.unit}</span>
                  {delta !== null && delta !== 0 && (
                    <span class={`font-mono text-xs ${delta > 0 ? 'text-emerald-700' : 'text-red-600'}`}>
                      {delta > 0 ? '▲' : '▼'} {Math.abs(delta)}{m.unit}（{first.date}比）
                    </span>
                  )}
                  {delta === 0 && <span class="font-mono text-xs text-dim">横ばい（{first.date}比）</span>}
                </div>
                <div class="h-2 bg-charcoal/8 rounded-sm overflow-hidden mb-4">
                  <div class="h-full bg-gold" style={`width:${pct}%`}></div>
                </div>
                <ul class="space-y-1.5">
                  {pts.map((p) => (
                    <li class="flex gap-3 text-xs text-mid">
                      <span class="font-mono text-dim shrink-0 w-20">{p.date}</span>
                      <span class="font-bold text-charcoal shrink-0 w-14">{p.value}{m.unit}</span>
                      {p.note && <span class="text-dim leading-relaxed">{p.note}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
        <p class="mt-8 text-xs text-dim leading-relaxed fade-in-up">
          ※ インデックス数・表示回数の初期の伸び（6月初旬→6/12）は、ローンチ直後の自然なインデックス進行によるものです。<strong class="text-charcoal">診断改善の効果は baseline（{caseMeta.baselineDate}）以降の変化として追記していきます。</strong>
        </p>
      </div>
    </section>

    <!-- AI引用率: 想定 vs 実測 -->
    <section class="py-20 lg:py-28 bg-cream grain-overlay relative">
      <div class="mx-auto max-w-5xl px-6 lg:px-12 relative z-10">
        <div class="mb-10 max-w-2xl">
          <div class="flex items-center gap-3 mb-4 fade-in-up">
            <div class="w-8 h-px bg-gold"></div>
            <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">Projection vs Actual</span>
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-charcoal mb-4 fade-in-up stagger-1">AI引用率 — 想定と実測</h2>
          <p class="text-mid text-base leading-relaxed fade-in-up stagger-2">
            AI引用率は権威性（被リンク）に依存し、動くまで数ヶ月かかります。下は改善ロードマップに基づく<strong class="text-charcoal">想定経路</strong>です。実測はまだ baseline の 0% 1点のみ。<strong class="text-charcoal">想定どおりに動いたか・外れたかも、実測が出たらそのまま並べて公開します。</strong>
          </p>
        </div>

        <div class="bg-parchment border border-charcoal/8 p-7 lg:p-9 fade-in-up stagger-2">
          <div class="flex items-center gap-5 mb-6 text-xs font-mono">
            <span class="flex items-center gap-2"><span class="w-4 h-2 bg-gold inline-block"></span>実測</span>
            <span class="flex items-center gap-2"><span class="w-4 h-0 border-t-2 border-dashed border-charcoal/40 inline-block"></span>想定（実測ではありません）</span>
          </div>
          <div class="grid grid-cols-4 gap-3 lg:gap-5 items-end h-56">
            {projection.stages.map((s) => {
              const h = Math.max(4, Math.round((s.mid / 40) * 100));
              return (
                <div class="flex flex-col items-center justify-end h-full">
                  <div class="text-xs font-bold text-charcoal mb-2">{s.range}</div>
                  {s.measured ? (
                    <div class="w-full bg-gold" style={`height:${h}%;min-height:6px`}></div>
                  ) : (
                    <div class="w-full border-2 border-dashed border-charcoal/30 bg-charcoal/[0.03]" style={`height:${h}%`}></div>
                  )}
                  <div class="mt-3 text-center">
                    <div class="text-xs font-bold text-charcoal">{s.stage}</div>
                    <div class="font-mono text-[10px] text-dim mt-0.5">{s.measured ? '実測' : '想定'}</div>
                  </div>
                </div>
              );
            })}
          </div>
          <p class="mt-7 pt-5 border-t border-charcoal/8 text-xs text-dim leading-relaxed">{projection.note}</p>
        </div>
      </div>
    </section>

    <!-- 施策ごとの結果（失敗も公開） -->
    <section class="py-20 lg:py-28 bg-charcoal grain-overlay grain-overlay-dark relative">
      <div class="mx-auto max-w-5xl px-6 lg:px-12 relative z-10">
        <div class="mb-10 max-w-2xl">
          <div class="flex items-center gap-3 mb-4 fade-in-up">
            <div class="w-8 h-px bg-gold"></div>
            <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">Results · Including Failures</span>
          </div>
          <h2 class="text-2xl lg:text-3xl font-bold text-cream mb-4 fade-in-up stagger-1">施策ごとの結果</h2>
          <p class="text-dim text-sm leading-[1.9] fade-in-up stagger-2">
            診断で提示した施策を一つずつ実装し、それぞれの効果を測って記録します。<strong class="text-cream">効果がなかった施策（効果なし）も、そのまま公開します。</strong>うまくいったものだけ見せるのは、検証とは呼べないからです。
          </p>
        </div>
        <div class="space-y-3">
          {actionResults.map((a) => {
            const v = verdictStyle[a.verdict] ?? verdictStyle.pending;
            return (
              <div class="flex items-start gap-4 bg-charcoal/50 border border-cream/10 p-5 fade-in-up">
                <span class="font-mono text-xs font-bold text-gold shrink-0 mt-1 w-7">{a.phase}</span>
                <div class="flex-1">
                  <div class="text-cream text-sm leading-relaxed">{a.action}</div>
                  {a.result && <div class="text-dim text-xs mt-1 leading-relaxed">{a.result}</div>}
                </div>
                <span class={`font-mono text-[10px] tracking-wide uppercase shrink-0 px-2.5 py-1 border ${v.cls}`}>{v.label}</span>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 再現・CTA -->
    <section class="py-20 lg:py-28 bg-cream grain-overlay relative">
      <div class="mx-auto max-w-5xl px-6 lg:px-12 relative z-10">
        <h2 class="text-2xl lg:text-3xl font-bold text-charcoal mb-4 fade-in-up">数字は、誰でも再現できます。</h2>
        <p class="text-mid text-base leading-[1.9] max-w-3xl mb-6 fade-in-up stagger-1">
          このケースの LLMO基板スコアは、次のコマンドで今すぐ手元から再現できます（OSS・無料）。私たちが出している数字がブラックボックスでないことの担保です。
        </p>
        <div class="bg-deep text-cream font-mono text-sm p-5 lg:p-6 mb-10 overflow-x-auto fade-in-up stagger-2">
          <span class="text-dim/70">$ </span>npx llmo-checker https://legacydram.com --json
        </div>
        <div class="flex flex-wrap gap-4 fade-in-up stagger-3">
          <a href={`${base}llmo-audit/`} class="inline-flex items-center gap-3 px-8 py-4 bg-gold hover:bg-gold-light text-charcoal text-sm font-bold tracking-wide transition-colors duration-300">
            自社サイトの診断を申し込む <span>→</span>
          </a>
          <a href={samplePdf} target="_blank" class="inline-flex items-center gap-3 px-8 py-4 border border-charcoal/15 hover:border-gold/50 text-charcoal text-sm font-mono tracking-wide transition-colors duration-300">
            16ページのサンプルを見る <span class="text-gold">→</span>
          </a>
        </div>
        <p class="mt-10 text-xs text-faint/50 font-mono tracking-wide fade-in-up">
          今後、Case #002 / #003 と公開ケースを追加していきます。
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
