---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const navItems = [
  { label: 'トップ', href: base },
  { label: '事業紹介', href: `${base}products` },
  { label: '会社概要', href: `${base}company` },
  { label: 'お問い合わせ', href: `${base}#contact` },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-cream/90 backdrop-blur-md border-b border-charcoal/5">
  <div class="mx-auto max-w-7xl px-6 lg:px-12 py-4 flex items-center justify-between">
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 group">
      <img
        src={`${base}images/propel-lab-logo-header.png`}
        alt="Propel-Lab"
        class="h-8 w-auto opacity-90 group-hover:opacity-100 transition-opacity"
      />
    </a>
    <button
      id="menu-toggle"
      class="text-charcoal md:hidden"
      aria-label="メニュー"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
    <nav id="nav-menu" class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm tracking-wide text-mid hover:text-charcoal transition-colors duration-300 font-mono"
        >
          {item.label}
        </a>
      ))}
      <a
        href={`${base}en`}
        class="text-xs text-dim hover:text-charcoal transition-colors duration-300 font-mono ml-2 border border-charcoal/15 rounded px-2.5 py-1 hover:border-charcoal/30"
      >
        EN
      </a>
    </nav>
  </div>
  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden md:hidden bg-cream/95 backdrop-blur-md border-t border-charcoal/5">
    <div class="px-6 py-3 flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm text-mid hover:text-charcoal py-2.5 transition-colors font-mono tracking-wide"
        >
          {item.label}
        </a>
      ))}
      <a
        href={`${base}en`}
        class="text-xs text-dim hover:text-charcoal py-2.5 transition-colors font-mono"
      >
        🌐 English
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
