---
import { company } from '../data/company';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<footer class="bg-deep text-dim py-16 relative">
  <div class="mx-auto max-w-7xl px-6 lg:px-12">
    <div class="grid lg:grid-cols-12 gap-10 mb-12">
      <!-- Brand -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3 mb-4">
          <img
            src={`${base}images/propel-lab-logo-header.png`}
            alt="Propel-Lab"
            class="h-7 w-auto opacity-60 brightness-0 invert"
          />
        </div>
        <p class="text-sm leading-relaxed text-dim/70 max-w-sm">{company.mission}</p>
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-3">
        <div class="font-mono text-[10px] text-faint/40 tracking-[0.2em] uppercase mb-4">Navigation</div>
        <ul class="space-y-2">
          <li><a href={base} class="text-sm text-dim/70 hover:text-cream transition-colors font-mono">トップ</a></li>
          <li><a href={`${base}products`} class="text-sm text-dim/70 hover:text-cream transition-colors font-mono">事業紹介</a></li>
          <li><a href={`${base}company`} class="text-sm text-dim/70 hover:text-cream transition-colors font-mono">会社概要</a></li>
          <li><a href={`${base}#contact`} class="text-sm text-dim/70 hover:text-cream transition-colors font-mono">お問い合わせ</a></li>
        </ul>
      </div>

      <!-- Company info -->
      <div class="lg:col-span-4">
        <div class="font-mono text-[10px] text-faint/40 tracking-[0.2em] uppercase mb-4">Company</div>
        <ul class="text-sm space-y-2 text-dim/70">
          <li class="font-mono text-xs">{company.name}</li>
          <li class="font-mono text-xs">{company.address}</li>
          <li>
            <a href={`mailto:${company.email}`} class="font-mono text-xs hover:text-cream transition-colors">
              {company.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-cream/5 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-[11px] font-mono text-dim/40 tracking-wider">
        &copy; {new Date().getFullYear()} {company.name}
      </p>
      <div class="flex items-center gap-4">
        <a href={`${base}en`} class="text-[11px] font-mono text-dim/40 hover:text-cream/60 transition-colors tracking-wider">English</a>
        <span class="text-dim/20">·</span>
        <span class="text-[11px] font-mono text-dim/30 tracking-wider">Fukuoka, Japan</span>
      </div>
    </div>
  </div>
</footer>
