---
import { services } from '../data/services';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const serviceImages: Record<string, string> = {
  'LLMO診断・実装伴走': 'llmo-audit-diagnostic.jpg',
  'LearningMate': 'learningmate-education.jpg',
  'AI-Loop': 'ai-loop-concept.jpg',
  'AutoCrew': 'autocrew-agent-system.jpg',
  'Yureru': 'yumei-butterfly.jpg',
  'KaoriQ': 'kaoriq-ec-automation.jpg',
  'mypcrig': 'mypcrig-content-media.jpg',
  'legacydram': 'legacydram-curation-media.jpg',
};

---

<section id="services" class="py-24 lg:py-32 bg-sand grain-overlay blueprint-grid relative">
  <div class="mx-auto max-w-7xl px-6 lg:px-12 relative z-10">
    <!-- Section header: left-aligned -->
    <div class="mb-16 lg:mb-20 max-w-2xl">
      <div class="flex items-center gap-3 mb-4 fade-in-up">
        <div class="w-8 h-px bg-gold"></div>
        <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">Services</span>
      </div>
      <h2 class="text-3xl lg:text-4xl font-bold text-charcoal mb-4 fade-in-up stagger-1">事業紹介</h2>
      <p class="text-mid text-base leading-relaxed fade-in-up stagger-2">AI・LLM技術を軸にした8つの事業を展開</p>
    </div>

    <!-- Service cards: varied layout -->
    <div class="space-y-6 lg:space-y-0 lg:grid lg:grid-cols-12 lg:gap-6">
      {services.map((service, i) => {
        // Alternating card sizes for 8 services: each row sums to 12 (7-5 / 5-7 …)
        const colSpan = i % 4 === 0 || i % 4 === 3 ? 'lg:col-span-7' : 'lg:col-span-5';
        const imgFile = serviceImages[service.name] || '';
        const num = String(i + 1).padStart(2, '0');
        const internalUrl = service.id === 'yureru' ? `${base}yureru/` : service.id === 'learningmate' ? `${base}learningmate/` : service.id === 'llmo-audit' ? `${base}services/` : null;
        const linkUrl = internalUrl ?? service.external_url ?? null;
        const isExternal = !internalUrl && !!service.external_url;

        return (
          <div class={`${colSpan} fade-in-up stagger-${i + 1}`}>
            <div class="group bg-parchment border border-charcoal/8 overflow-hidden card-lift h-full">
              <!-- Image -->
              <div class="h-48 lg:h-56 overflow-hidden relative">
                <img
                  src={`${base}images/${imgFile}`}
                  alt={service.name}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-charcoal/30 to-transparent"></div>
                <!-- Number overlay -->
                <div class="absolute top-4 left-5 font-mono text-sm text-cream/70 tracking-widest">{num}</div>
              </div>

              <!-- Content -->
              <div class="p-6 lg:p-8">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <h3 class="text-xl font-bold text-charcoal group-hover:text-gold transition-colors duration-300">
                    {linkUrl ? (
                      <a
                        href={linkUrl}
                        {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                        class="hover:text-gold transition-colors"
                      >
                        {service.name}
                        <span class="text-gold ml-2 text-sm">{isExternal ? '↗' : '→'}</span>
                      </a>
                    ) : service.name}
                  </h3>
                  <span class="font-mono text-[10px] text-dim tracking-wider uppercase whitespace-nowrap mt-1.5">{service.category}</span>
                </div>

                <p class="text-mid text-sm leading-relaxed mb-4">{service.summary}</p>

                <p class="text-xs text-dim mb-4">
                  <span class="font-mono text-[10px] tracking-wider text-gold-muted mr-2">TARGET</span>
                  {service.target}
                </p>

                <div class="flex flex-wrap gap-2 pt-3 border-t border-charcoal/5">
                  {service.tech.map((t) => (
                    <span class="text-[11px] font-mono px-2.5 py-1 bg-charcoal/5 text-charcoal/70 tracking-wide">{t}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Link equity to /products/ detail page -->
    <div class="mt-12 lg:mt-16 flex justify-center fade-in-up">
      <a
        href={`${base}products/`}
        class="group inline-flex items-center gap-3 px-7 py-3.5 border border-charcoal/15 hover:border-gold/50 text-charcoal text-sm font-mono tracking-wide transition-colors duration-300"
      >
        8事業の詳細を見る
        <span class="text-gold group-hover:translate-x-1 transition-transform duration-300">→</span>
      </a>
    </div>
  </div>
</section>
