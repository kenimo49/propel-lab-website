---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout title="会社概要｜代表 井本 賢 — 合同会社 Propel-Lab" description="合同会社Propel-Labの会社概要。福岡市天神を拠点に、代表社員 井本 賢 がAI・LLM技術を活用した事業を展開。LLMOフレームワーク・ハーネスエンジニアリングを書籍・OSS・公開研究として実装する研究運営型ラボ。">
  <Header />
  <main class="pt-24 pb-20">
    <div class="mx-auto max-w-4xl px-4">
      <h1 class="text-4xl font-bold mb-12">会社概要</h1>

      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-6 pb-2 border-b border-gray-200">基本情報</h2>
        <dl class="grid grid-cols-[8rem_1fr] gap-y-3 text-sm">
          <dt class="font-medium text-gray-500 border-b border-gray-100 pb-3">会社名</dt>
          <dd class="text-gray-800 border-b border-gray-100 pb-3">{company.name}（{company.nameKana}）</dd>
          <dt class="font-medium text-gray-500 border-b border-gray-100 pb-3">所在地</dt>
          <dd class="text-gray-800 border-b border-gray-100 pb-3">{company.address}</dd>
          <dt class="font-medium text-gray-500 border-b border-gray-100 pb-3">代表者</dt>
          <dd class="text-gray-800 border-b border-gray-100 pb-3">{company.representative}（{company.representativeKana}）</dd>
          <dt class="font-medium text-gray-500 border-b border-gray-100 pb-3">設立</dt>
          <dd class="text-gray-800 border-b border-gray-100 pb-3">{company.founded}</dd>
          <dt class="font-medium text-gray-500 border-b border-gray-100 pb-3">資本金</dt>
          <dd class="text-gray-800 border-b border-gray-100 pb-3">{company.capital}</dd>
          <dt class="font-medium text-gray-500 border-b border-gray-100 pb-3">メール</dt>
          <dd class="text-gray-800 border-b border-gray-100 pb-3"><a class="text-accent hover:underline" href={`mailto:${company.email}`}>{company.email}</a></dd>
          <dt class="font-medium text-gray-500">URL</dt>
          <dd class="text-gray-800"><a class="text-accent hover:underline" href={company.url}>propel-lab.co.jp</a></dd>
        </dl>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-4 pb-2 border-b border-gray-200">ミッション</h2>
        <p class="text-lg text-gray-700 leading-relaxed">「{company.mission}」</p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-6 pb-2 border-b border-gray-200">代表者プロフィール</h2>
        <div class="bg-[#0f172a] rounded-2xl p-8 text-center">
          <img
            src={`${base}images/avatar.jpg`}
            alt={profile.name}
            class="w-32 h-32 rounded-full object-cover mx-auto mb-4"
            style="border: 3px solid #1e3a5f;"
          />
          <h3 class="text-xl font-bold text-white mb-1">{profile.name}</h3>
          <p class="text-gray-400 mb-1">{profile.nameEn} / {profile.title}</p>
          <p class="text-sm text-gray-500 tracking-wider mb-6">Harness Engineering · AI Agent Design · Technical Publishing</p>

          <p class="text-gray-300 text-sm leading-relaxed max-w-xl mx-auto mb-6">
            ロボットのSLAM制御から始まり、WebRTC×リアルタイム通信、Android/Webアプリ開発を経て、現在はAIエージェントの制御設計を専門とする。OpenAI・Anthropic・LangChainのハーネス設計を体系化し、AGENTS.md/CLAUDE.mdの実践設計、hooks/lifecycle/フィードバックループの構築に取り組む。Kindle 14冊。技術の実践知を書籍・記事で体系化して届ける。
          </p>

          <div class="flex flex-wrap justify-center gap-2 mb-6">
            {['Harness Engineering', 'CLAUDE.md', 'AGENTS.md', 'Claude Code', 'MCP', 'Context Engineering', 'TypeScript', 'Python', 'LLM', 'Kindle Publishing'].map((tag) => (
              <span class="px-3 py-1 bg-[#1e293b] text-[#60a5fa] text-xs rounded-full border border-[#334155]">
                {tag}
              </span>
            ))}
          </div>

          <div class="flex flex-wrap items-center justify-center gap-3 mb-4">
            <a href="https://kenimoto.dev" target="_blank" rel="noopener noreferrer"
              class="px-5 py-2 bg-[#60a5fa] text-[#0f172a] rounded-lg hover:bg-[#93c5fd] transition-colors font-bold text-sm">
              kenimoto.dev →
            </a>
            <a href="https://www.linkedin.com/in/kenimo49" target="_blank" rel="noopener noreferrer"
              class="px-5 py-2 bg-[#1e293b] text-white rounded-lg hover:bg-[#334155] transition-colors text-sm border border-[#334155]">
              LinkedIn
            </a>
          </div>

          <div class="flex flex-wrap justify-center gap-3">
            {Object.entries(profile.links).filter(([name]) => name !== 'linkedin' && name !== 'portfolio').map(([name, url]) => (
              <a href={url} target="_blank" rel="noopener noreferrer"
                class="text-sm text-[#64748b] hover:text-[#60a5fa] transition-colors">
                {name.charAt(0).toUpperCase() + name.slice(1)}
              </a>
            ))}
          </div>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
