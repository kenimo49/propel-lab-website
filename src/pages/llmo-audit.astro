---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';
import { llmoAuditServiceSchema } from '../lib/schemas';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const samplePdf = `${base}files/llmo-audit-sample-legacydram.pdf`;

// Stripe Payment Link 発行後にここへURLを設定すると決済ボタンが出る（現在はフォーム申込のみ）
const stripePaymentLink: string | null = 'https://buy.stripe.com/eVq00l7LMbJN8CL3M9fMA00';

const applySubject = encodeURIComponent('【LLMO診断 申込】対象ドメイン: ');
const applyBody = encodeURIComponent(
  `以下をご記入のうえ、そのまま送信してください。1営業日以内に着手日と請求書をご案内します。

1. 対象ドメイン（1ドメイン）:
2. 会社名 / お名前:
3. AI検索で狙いたい検索語・質問（最大10個、わかる範囲で）:
4. GA4 / Search Console の閲覧権限付与（任意・精密診断へ無料アップグレード）: 検討できる / 難しい / 相談したい
5. その他、気になっている点（任意）:
`,
);
const applyMailto = `mailto:${company.email}?subject=${applySubject}&body=${applyBody}`;

const scopeItems = [
  {
    name: 'llmo-checker 全ページスキャン',
    detail: 'LLMO Score（0-100）とチェック項目別の内訳をページ単位で算出。どのページの、どのシグナルが欠けているかを特定します。',
  },
  {
    name: '構造監査',
    detail: 'llms.txt / robots.txt のAIクローラー姿勢 / JSON-LD構造化データ / canonical / hreflang を実ファイルベースで監査します。',
  },
  {
    name: 'AI引用実測（中核診断）',
    detail: 'Perplexity / Claude / Gemini / ChatGPT の4エンジンに実クエリを投入し、クエリ×エンジン×5試行で「引用率」を算出。競合3社との引用シェア（Share of Voice）も1枚に可視化します。',
  },
  {
    name: '競合ベンチマーク',
    detail: '同テーマで上位に立つ競合サイトの LLMO 基板スコアを実測し、相対的な立ち位置を可視化。「技術は競合より上なのに引用されない」のか「技術自体に遅れがあるのか」を切り分け、改善の力点を間違えないようにします。',
  },
  {
    name: '外部実測データ',
    detail: 'CrUX API による Core Web Vitals 実ユーザーデータ、インデックス状況・検索順位の外部確認。権限なしで取得できる実データを揃えます。',
  },
  {
    name: 'GA4 / Search Console 実データ分析（精密診断）',
    detail: '閲覧権限をご提供いただいた場合のみ。実クエリ・CTR・順位・流入チャネルまで踏み込みます。権限付与は任意で、3分で終わる手順書をお渡しします。',
  },
  {
    name: 'P0 / P1 / P2 改善ロードマップ',
    detail: 'すべての発見事項を「今すぐ直す / 次に直す / 余力があれば」の3段階に優先度付けし、PDFレポート + 改善チェックリストとして納品します。',
  },
];

const faqItems = [
  {
    question: 'GA4 や Search Console の権限付与は必須ですか？',
    answer:
      '不要です。標準診断（構造監査・AI引用実測・競合比較・Core Web Vitals）は権限ゼロで完結します。閲覧権限をご提供いただける場合は、実クエリ・CTR・流入分析まで踏み込む精密診断へ無料でアップグレードします。付与手順は3分で終わる手順書をお渡しします（SEO業界で標準的な、閲覧者ロールの追加のみです）。',
  },
  {
    question: '改善の実装まで代行してもらえますか？',
    answer:
      '診断には実装代行は含まれません。納品物は「何を・どの順で・なぜ直すか」を特定したロードマップとチェックリストで、社内エンジニアや既存の制作会社がそのまま着手できる粒度で書きます。実装まで支援が必要な場合は、診断ご購入者様向けの実装伴走（月額制）をご案内します。',
  },
  {
    question: '複数ドメインをまとめて診断できますか？',
    answer:
      '1申込 = 1ドメインの範囲固定です。サブドメインや複数サイトをお持ちの場合は、優先度の高い1ドメインから始めることをおすすめします。複数ドメインの一括診断はお問い合わせください。',
  },
  {
    question: '納期はどのくらいですか？',
    answer: '申込内容の確定から2週間以内に納品します。対象クエリのすり合わせ等はメールで非同期に行うため、お打ち合わせの調整は不要です。',
  },
  {
    question: '支払い方法は？',
    answer: '請求書発行による銀行振込に対応しています。クレジットカード決済（Stripe）は準備中です。',
  },
  {
    question: 'AI引用実測とは何ですか？',
    answer:
      'お客様のサイトが狙う検索語・質問を Perplexity / Claude / Gemini / ChatGPT に実際に投入し、AIの回答がどのサイトを引用したかを記録する実測です。単発の結果は確率的に揺れるため、クエリ×エンジン×5試行を重ねて「引用率」として統計的に算出します。ツールによる静的チェックでは決して分からない「AIに実際に選ばれているか」を数字にします。',
  },
  {
    question: '診断を受ければAIに引用されるようになりますか？',
    answer:
      '診断は現状の実測と、優先度付きの改善計画を提供するものです。検索順位やAI引用の獲得そのものを保証するものではありません。引用の獲得には改善の実装と、ドメイン権威性の積み上げ（数ヶ月単位）が必要です。だからこそ、効果の薄い施策に時間を使わないための優先度付けに価値があると考えています。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://propel-lab.co.jp/llmo-audit/#faq',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title="LLMO診断レポート ¥98,000 — AI検索にあなたのサイトは引用されているか | Propel-Lab"
  description="1ドメイン・¥98,000・納期2週間の範囲固定LLMO診断。llmo-checker全ページスキャン、llms.txt/JSON-LD構造監査、Perplexity/Claude/Gemini/ChatGPT 4エンジンでのAI引用実測、競合ベンチマーク、機会損失の可視化、P0/P1/P2改善ロードマップをPDFで納品。KPIサマリー付きのサンプルレポート（16ページ）公開中。"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify([llmoAuditServiceSchema, faqSchema])} />
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative pt-36 pb-24 lg:pt-44 lg:pb-32 bg-charcoal grain-overlay grain-overlay-dark overflow-hidden">
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(139, 105, 20, 0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 105, 20, 0.5) 1px, transparent 1px); background-size: 48px 48px;"></div>
      <div class="mx-auto max-w-7xl px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6">
            <div class="flex items-center gap-3 mb-5 fade-in-up">
              <div class="w-8 h-px bg-gold"></div>
              <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">LLMO Audit</span>
            </div>
            <h1 class="text-3xl lg:text-5xl font-bold text-cream leading-tight mb-6 fade-in-up stagger-1">
              AIに、<br />引用される<br />会社になる。
            </h1>
            <p class="text-dim text-base leading-relaxed mb-8 fade-in-up stagger-2">
              ChatGPT・Claude・Gemini・Perplexity であなたのサイトの可視性と引用率を実測し、競合と比べて「なぜ引用されないのか」「何をどの順で直すか」を改善ロードマップとして提示する、範囲固定のLLMO診断サービスです。
            </p>
            <div class="flex flex-wrap items-center gap-x-8 gap-y-3 mb-10 fade-in-up stagger-3">
              <div>
                <div class="font-mono text-[10px] text-faint/50 tracking-[0.2em] uppercase mb-1">Price</div>
                <div class="text-cream text-2xl font-bold">¥98,000<span class="text-dim text-sm font-normal ml-1">（税別）</span></div>
              </div>
              <div>
                <div class="font-mono text-[10px] text-faint/50 tracking-[0.2em] uppercase mb-1">Delivery</div>
                <div class="text-cream text-2xl font-bold">2週間<span class="text-dim text-sm font-normal ml-1">以内</span></div>
              </div>
              <div>
                <div class="font-mono text-[10px] text-faint/50 tracking-[0.2em] uppercase mb-1">Scope</div>
                <div class="text-cream text-2xl font-bold">1<span class="text-dim text-sm font-normal ml-1">ドメイン</span></div>
              </div>
            </div>
            <div class="flex flex-wrap gap-4 fade-in-up stagger-4">
              <a
                href="#apply"
                class="inline-flex items-center gap-3 px-8 py-4 bg-gold hover:bg-gold-light text-charcoal text-sm font-bold tracking-wide transition-colors duration-300"
              >
                診断を申し込む <span>→</span>
              </a>
              <a
                href={samplePdf}
                target="_blank"
                class="inline-flex items-center gap-3 px-8 py-4 border border-cream/20 hover:border-gold/50 text-cream text-sm font-mono tracking-wide transition-colors duration-300"
              >
                サンプルレポートを見る（PDF・16ページ）
              </a>
            </div>
          </div>

          <!-- Right: checker output sample (実測値) -->
          <div class="lg:col-span-6 fade-in-up stagger-3">
            <div class="bg-deep border border-cream/10 p-6 lg:p-8 font-mono text-sm leading-relaxed shadow-2xl">
              <div class="flex items-center gap-2 mb-5 pb-4 border-b border-cream/10">
                <span class="w-2.5 h-2.5 rounded-full bg-cream/15"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-cream/15"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-cream/15"></span>
                <span class="text-dim/60 text-xs ml-2">llmo-checker</span>
              </div>
              <div class="text-dim/80 mb-4">$ llmo-checker https://your-site.com/blog/</div>
              <div class="mb-4">
                <span class="text-cream font-bold">LLMO Score</span>
                <span class="text-amber font-bold ml-3 text-lg">72/100</span>
                <span class="text-dim/60 ml-2 text-xs">needs work</span>
              </div>
              <div class="space-y-1.5 text-xs lg:text-sm">
                <div><span class="text-green-500/90">PASS</span> <span class="text-cream/80">llms.txt presence and structure</span> <span class="text-dim/50">100/100</span></div>
                <div><span class="text-green-500/90">PASS</span> <span class="text-cream/80">AI crawler posture (robots.txt)</span> <span class="text-dim/50">100/100</span></div>
                <div><span class="text-red-400">FAIL</span> <span class="text-cream/80">JSON-LD structured data</span> <span class="text-dim/50">0/100</span></div>
                <div><span class="text-green-500/90">PASS</span> <span class="text-cream/80">Canonical URL and hreflang</span> <span class="text-dim/50">100/100</span></div>
                <div><span class="text-amber">WARN</span> <span class="text-cream/80">Semantic metadata and headings</span> <span class="text-dim/50">78/100</span></div>
              </div>
              <div class="mt-5 pt-4 border-t border-cream/10 text-xs text-dim/60">
                スコアは入口にすぎません。診断ではこの先 —— AIが実際にあなたを引用しているか —— を実測します。
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- サンプル診断の結果 -->
    <section class="py-20 lg:py-28 bg-cream grain-overlay relative">
      <div class="mx-auto max-w-7xl px-6 lg:px-12 relative z-10">
        <div class="mb-10 max-w-2xl">
          <div class="flex items-center gap-3 mb-4 fade-in-up">
            <div class="w-8 h-px bg-gold"></div>
            <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">Sample Result</span>
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-charcoal mb-4 fade-in-up stagger-1">実際の診断は、こう出る。</h2>
          <p class="text-mid text-base leading-relaxed fade-in-up stagger-2">
            当社が運営する公開メディア <strong class="text-charcoal">legacydram.com</strong> を診断した実測結果の一部です。技術基板は競合を上回るのに、AIには一度も引用されていない——という構造が数字で見えます。
          </p>
        </div>

        <!-- KPI stat band -->
        <div class="grid sm:grid-cols-3 border border-charcoal/10 fade-in-up stagger-2">
          <div class="bg-charcoal text-center px-5 py-8 border-b sm:border-b-0 sm:border-r border-cream/10">
            <div class="text-5xl font-bold text-red-300 mb-2">0%</div>
            <div class="text-cream text-sm font-bold mb-1">AI引用率</div>
            <div class="text-dim text-xs">専用記事を持つクエリで被引用ゼロ（実測2クエリ）</div>
          </div>
          <div class="bg-charcoal text-center px-5 py-8 border-b sm:border-b-0 sm:border-r border-cream/10">
            <div class="text-5xl font-bold text-red-300 mb-2">100%</div>
            <div class="text-cream text-sm font-bold mb-1">失われている露出機会</div>
            <div class="text-dim text-xs">同じ問いで競合だけが引用されている</div>
          </div>
          <div class="bg-charcoal text-center px-5 py-8">
            <div class="text-5xl font-bold text-emerald-300 mb-2">+43</div>
            <div class="text-cream text-sm font-bold mb-1">競合平均との基板スコア差</div>
            <div class="text-dim text-xs">93 vs 競合平均50（実測4サイト中1位）</div>
          </div>
        </div>

        <!-- Before / After -->
        <div class="mt-8 bg-parchment border border-charcoal/8 p-6 lg:p-8 fade-in-up stagger-3">
          <div class="font-mono text-[10px] text-dim tracking-[0.2em] uppercase mb-5">Before → After（AI引用率）</div>
          <div class="flex items-center gap-5 lg:gap-10">
            <div class="text-center">
              <div class="font-mono text-[10px] text-dim tracking-wide uppercase mb-1">診断前</div>
              <div class="text-3xl lg:text-4xl font-bold text-charcoal">0%</div>
            </div>
            <div class="text-gold text-2xl lg:text-3xl">→</div>
            <div class="text-center">
              <div class="font-mono text-[10px] text-dim tracking-wide uppercase mb-1">改善後（想定）</div>
              <div class="text-3xl lg:text-4xl font-bold text-gold-muted">5〜20%</div>
            </div>
            <p class="text-mid text-xs leading-relaxed flex-1 pl-2 lg:pl-6 border-l border-charcoal/10">
              P0/P1で基板を完成させると引用が立ち上がり、権威性（被リンク）を積むP2で競合と引用を争えるレンジへ。<span class="text-dim">※達成を保証する数値ではなく想定レンジです。</span>
            </p>
          </div>
        </div>

        <!-- Prominent PDF CTA -->
        <div class="mt-10 text-center fade-in-up stagger-4">
          <a
            href={samplePdf}
            target="_blank"
            class="inline-flex items-center gap-3 px-10 py-5 bg-gold hover:bg-gold-light text-charcoal text-base font-bold tracking-wide transition-colors duration-300 shadow-lg"
          >
            実際の16ページサンプルレポートを見る <span>→</span>
          </a>
          <p class="mt-3 font-mono text-[11px] text-dim tracking-wide">PDF・全16ページ・legacydram の数値はすべて実測</p>
        </div>
      </div>
    </section>

    <!-- この診断で分かること -->
    <section class="py-16 lg:py-20 bg-deep grain-overlay grain-overlay-dark relative">
      <div class="mx-auto max-w-7xl px-6 lg:px-12 relative z-10">
        <div class="flex items-center gap-3 mb-8 fade-in-up">
          <div class="w-8 h-px bg-gold"></div>
          <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">What You'll Learn</span>
          <span class="text-cream/90 text-sm font-bold ml-1">この診断で分かること</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
          {[
            { t: 'AI引用率', d: '4エンジンで実際に引用されているか' },
            { t: '競合比較', d: '競合に対する立ち位置を実測ベンチマーク' },
            { t: '機会損失', d: '引用を競合に明け渡している露出機会' },
            { t: '優先度付き改善案', d: 'P0 / P1 / P2 で効果順に整理' },
            { t: '実装ロードマップ', d: 'そのまま着手できる粒度で納品' },
          ].map((item, i) => (
            <div class={`bg-charcoal/60 border border-cream/10 p-5 fade-in-up stagger-${Math.min(i + 1, 6)}`}>
              <div class="flex items-center gap-2 mb-2">
                <span class="text-gold text-base font-bold">✓</span>
                <span class="text-cream text-sm font-bold">{item.t}</span>
              </div>
              <p class="text-dim text-xs leading-relaxed">{item.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 問題提起 -->
    <section class="py-24 lg:py-32 bg-cream grain-overlay relative">
      <div class="mx-auto max-w-7xl px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl">
          <div class="flex items-center gap-3 mb-4 fade-in-up">
            <div class="w-8 h-px bg-gold"></div>
            <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">Problem</span>
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-charcoal mb-8 fade-in-up stagger-1">
            専用記事を持っていても、<br class="hidden lg:block" />AIはあなたを引用しない。
          </h2>
          <div class="space-y-5 text-mid text-base leading-[1.9] fade-in-up stagger-2">
            <p>
              検索の入口は、Google の検索結果ページから AI の回答へ移りつつあります。ChatGPT や Perplexity が質問に直接答えるとき、引用されたサイトだけが読者に届き、引用されなかったサイトは——どれだけ内容が正確でも——存在しないのと同じです。
            </p>
            <p>
              これは仮説ではなく、実測できる現象です。当社が運営するメディアサイトの診断では、<strong class="text-charcoal">対象トピックの専用記事を持っているにもかかわらず、AIの回答が競合メディアだけを引用し、自サイトを一度も参照しない</strong>状態を確認しました。原因は記事の質ではなく、構造化データの欠落とドメイン権威性のシグナル不足でした。
            </p>
            <p>
              厄介なのは、この「引用されていない」という事実が、GA4 にも Search Console にも表示されないことです。アクセス解析は来た人しか数えられません。<strong class="text-charcoal">AI の回答であなたの代わりに競合が紹介されている機会損失は、実際に AI へクエリを投入して測るしかない</strong>のです。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 診断内容 -->
    <section class="py-24 lg:py-32 bg-sand grain-overlay blueprint-grid relative">
      <div class="mx-auto max-w-7xl px-6 lg:px-12 relative z-10">
        <div class="mb-16 max-w-2xl">
          <div class="flex items-center gap-3 mb-4 fade-in-up">
            <div class="w-8 h-px bg-gold"></div>
            <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">What You Get</span>
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-charcoal mb-4 fade-in-up stagger-1">診断内容（範囲固定）</h2>
          <p class="text-mid text-base leading-relaxed fade-in-up stagger-2">
            診断は権限不要の<strong class="text-charcoal">標準診断</strong>で完結します。GA4 / Search Console の閲覧権限をご提供いただいた場合は、追加費用なしで<strong class="text-charcoal">精密診断</strong>にアップグレードします。
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {scopeItems.map((item, i) => (
            <div class={`bg-parchment border border-charcoal/8 p-7 lg:p-8 card-lift fade-in-up stagger-${Math.min(i + 1, 6)}`}>
              <div class="flex items-start gap-4 mb-3">
                <span class="font-mono text-xs text-gold/70 mt-1.5 shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="text-lg font-bold text-charcoal">{item.name}</h3>
              </div>
              <p class="text-mid text-sm leading-[1.8] pl-9">{item.detail}</p>
            </div>
          ))}
        </div>

        <!-- AI引用実測の強調 -->
