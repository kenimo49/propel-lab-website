---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { services } from '../data/services';
import { serviceSchemas } from '../lib/schemas';

const projects = services.filter((s) => s.kind === 'project');
const projectIds = new Set(projects.map((p) => p.id));
const projectSchemas = serviceSchemas.filter((s) =>
  projectIds.has(s['@id'].replace('https://propel-lab.co.jp/#service-', '')),
);
---

<Layout
  title="自社プロジェクト・LLMO実証ラボ — 合同会社 Propel-Lab"
  description="Propel-Lab が自社で運用・LLMO実証している事業群。KaoriQ（フレグランスEC）/ mypcrig（PC選定メディア）/ legacydram（ウィスキーキュレーション）/ Yureru（音楽プロジェクト）の4プロジェクト。"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Propel-Lab 自社プロジェクト一覧",
      "itemListElement": projectSchemas.map((s, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": { "@id": s["@id"] },
      })),
    },
    ...projectSchemas,
  ])} />
  <Header />
  <main class="pt-24 pb-20">
    <div class="mx-auto max-w-4xl px-4">
      <h1 class="text-4xl font-bold mb-4">自社プロジェクト・LLMO実証ラボ</h1>
      <p class="text-gray-600 mb-12">
        Propel-Lab が自社で運用しているプロジェクト群。LLMOフレームワーク・harness-ops の実証実験の場としても機能しています。診断・伴走サービスをご検討の方は <a href={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/'}services/`} class="text-accent hover:underline">サービス・教材ページ</a> をご覧ください。
      </p>

      <div class="space-y-12">
        {projects.map((service) => {
          const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
          const internalHref = service.id === 'yureru' ? `${baseUrl}yureru/` : null;
          const externalHref = service.external_url ?? null;
          const navHref = internalHref ?? externalHref;
          const isExternal = !internalHref && !!externalHref;
          return (
          <section class={`bg-white rounded-xl p-8 border border-gray-100 shadow-sm ${navHref ? 'cursor-pointer hover:shadow-md transition-shadow' : ''}`}
            data-href={navHref ?? undefined}
            data-external={isExternal ? 'true' : undefined}>
            <div class="mb-4">
              <h2 class="text-2xl font-bold">
                {navHref ? (
                  <a href={navHref}
                     {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                     class="hover:text-accent transition-colors">{service.name} →</a>
                ) : service.name}
              </h2>
              <p class="text-sm text-accent font-medium">{service.category}</p>
            </div>
            <p class="text-gray-700 mb-4 text-lg">{service.summary}</p>
            <div class="grid sm:grid-cols-2 gap-4 text-sm">
              <div>
                <span class="font-medium text-gray-500">対象:</span>
                <span class="text-gray-700 ml-1">{service.target}</span>
              </div>
              {service.platforms && (
                <div>
                  <span class="font-medium text-gray-500">プラットフォーム:</span>
                  <span class="text-gray-700 ml-1">{service.platforms.join(', ')}</span>
                </div>
              )}
              {service.characters && (
                <div>
                  <span class="font-medium text-gray-500">キャラクター:</span>
                  <span class="text-gray-700 ml-1">{service.characters.join(', ')}</span>
                </div>
              )}
              {service.youtube && (
                <div>
                  <span class="font-medium text-gray-500">YouTube:</span>
                  <a href={service.youtube} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline ml-1">
                    チャンネルを見る
                  </a>
                </div>
              )}
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
              {service.tech.map((t) => (
                <span class="text-xs px-3 py-1 bg-navy/5 text-navy rounded-full">{t}</span>
              ))}
            </div>
          </section>
          );
        })}
      </div>
    </div>
  </main>
  <Footer />
  <script>
    document.querySelectorAll('[data-href]').forEach(el => {
      el.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.tagName !== 'A') {
          const href = (el as HTMLElement).dataset.href!;
          const isExternal = (el as HTMLElement).dataset.external === 'true';
          if (isExternal) {
            window.open(href, '_blank', 'noopener,noreferrer');
          } else {
            window.location.href = href;
          }
        }
      });
    });
  </script>
</Layout>
