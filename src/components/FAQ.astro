---
import { faqItems } from '../data/faq';
---

<section id="faq" class="py-24 lg:py-32 bg-sand grain-overlay blueprint-grid relative">
  <div class="mx-auto max-w-7xl px-6 lg:px-12 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12">
      <!-- Left: Section header -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <div class="flex items-center gap-3 mb-4 fade-in-up">
            <div class="w-8 h-px bg-gold"></div>
            <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">FAQ</span>
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-charcoal mb-4 fade-in-up stagger-1">よくある質問</h2>
          <p class="text-mid text-sm leading-relaxed fade-in-up stagger-2">
            事業内容やサービスに関する<br />よくあるご質問にお答えします。
          </p>
        </div>
      </div>

      <!-- Right: FAQ items -->
      <div class="lg:col-span-8 space-y-3">
        {faqItems.map((item, i) => (
          <details class={`group border-b border-charcoal/8 fade-in-up stagger-${Math.min(i + 1, 6)}`}>
            <summary class="py-5 cursor-pointer flex items-start justify-between gap-4 list-none">
              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-gold/60 mt-1 shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-charcoal font-medium text-sm lg:text-base leading-relaxed group-hover:text-gold transition-colors duration-300">{item.question}</span>
              </div>
              <span class="text-dim text-xs mt-1 shrink-0 group-open:rotate-45 transition-transform duration-300 font-mono">+</span>
            </summary>
            <div class="pb-5 pl-10 text-mid text-sm leading-[1.8]">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
