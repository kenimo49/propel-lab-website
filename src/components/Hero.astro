---
import { company } from '../data/company';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="relative min-h-screen flex items-end bg-cream overflow-hidden grain-overlay blueprint-grid">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-1/2 h-full opacity-[0.03]">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 70% 30%, var(--color-gold) 0%, transparent 70%);"></div>
  </div>

  <!-- Blueprint reference lines -->
  <div class="absolute top-24 left-12 lg:left-24 w-px h-32 bg-gold/15 hidden lg:block"></div>
  <div class="absolute top-24 left-12 lg:left-24 w-8 h-px bg-gold/15 hidden lg:block"></div>
  <div class="absolute bottom-48 right-12 lg:right-24 w-px h-24 bg-gold/10 hidden lg:block"></div>

  <!-- Monospace coordinates -->
  <div class="absolute top-28 right-8 lg:right-16 font-mono text-[10px] text-dim/40 tracking-widest hidden lg:block">
    33.5902°N 130.4017°E
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-12 pb-20 lg:pb-32 pt-32 lg:pt-0">
    <div class="grid lg:grid-cols-12 gap-8 items-end">
      <!-- Left: Main content — asymmetric, left-aligned -->
      <div class="lg:col-span-7 space-y-8">
        <!-- Section label -->
        <div class="flex items-center gap-3 fade-in-up">
          <div class="w-8 h-px bg-gold"></div>
          <span class="font-mono text-xs text-gold tracking-[0.2em] uppercase">Propel-Lab LLC</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.15] tracking-tight text-charcoal fade-in-up stagger-1">
          仕組みと<br class="hidden sm:block" />
          <span class="text-gold">エンジニアリング</span>の力で、<br />
          次世代の経営モデルを<br class="hidden sm:block" />構築する
        </h1>

        <p class="text-base md:text-lg text-mid leading-relaxed max-w-xl fade-in-up stagger-2">
          AI・LLM技術を活用した4つの事業を展開する、福岡発のテクノロジー企業。
        </p>

        <div class="flex flex-col sm:flex-row gap-4 pt-2 fade-in-up stagger-3">
          <a
            href={`${base}products/`}
            class="inline-flex items-center gap-2 px-7 py-3.5 bg-charcoal hover:bg-charcoal-light text-cream text-sm font-mono tracking-wide transition-colors duration-300"
          >
            事業紹介を見る
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" /></svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-7 py-3.5 border border-charcoal/20 hover:border-charcoal/40 text-charcoal text-sm font-mono tracking-wide transition-colors duration-300"
          >
            お問い合わせ
          </a>
        </div>
      </div>

      <!-- Right: Stats / Key numbers -->
      <div class="lg:col-span-5 lg:pl-12 fade-in-up stagger-4">
        <div class="border-l border-charcoal/10 pl-8 space-y-8 hidden lg:block">
          <div>
            <div class="font-mono text-4xl font-bold text-charcoal">4</div>
            <div class="text-xs text-dim font-mono tracking-wider mt-1">BUSINESS UNITS</div>
          </div>
          <div>
            <div class="font-mono text-4xl font-bold text-charcoal">80K<span class="text-lg text-mid ml-1">+</span></div>
            <div class="text-xs text-dim font-mono tracking-wider mt-1">QIITA PAGEVIEWS</div>
          </div>
          <div>
            <div class="font-mono text-4xl font-bold text-charcoal">10<span class="text-lg text-mid ml-1">冊</span></div>
            <div class="text-xs text-dim font-mono tracking-wider mt-1">KINDLE BOOKS</div>
          </div>
        </div>

        <!-- Mobile stats -->
        <div class="grid grid-cols-2 gap-6 lg:hidden mt-8 border-t border-charcoal/10 pt-8">
          <div>
            <div class="font-mono text-2xl font-bold text-charcoal">4</div>
            <div class="text-xs text-dim font-mono">事業展開</div>
          </div>
          <div>
            <div class="font-mono text-2xl font-bold text-charcoal">80K+</div>
            <div class="text-xs text-dim font-mono">Qiita PV</div>
          </div>
          <div>
            <div class="font-mono text-2xl font-bold text-charcoal">14冊</div>
            <div class="text-xs text-dim font-mono">Kindle</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom edge marker -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/20 to-transparent"></div>
</section>

<script>
  // Scroll-triggered animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.fade-in-up, .fade-in-left').forEach((el) => {
    observer.observe(el);
  });
</script>
