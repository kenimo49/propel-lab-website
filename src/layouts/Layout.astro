---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  noindex?: boolean;
  /** EN ページ等で /en/ を英語版として宣言したい場合に true */
  hasEnglishVersion?: boolean;
  /** 404 等で canonical を出力したくない場合に true */
  noCanonical?: boolean;
}

const {
  title,
  description = '合同会社Propel-Lab — 仕組みとエンジニアリングの力で次世代の経営モデルを構築する福岡拠点のAI/LLM技術コンサルティング法人。LLMOフレームワーク、ハーネスエンジニアリング、AI時代の事業運営自律化を書籍・OSS・公開研究として実装する研究運営型ラボ。',
  ogImage = 'og-image.jpg',
  lang = 'ja',
  noindex = false,
  hasEnglishVersion = false,
  noCanonical = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {!noCanonical && <link rel="canonical" href={canonicalURL.href} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {hasEnglishVersion && (
      <>
        <link rel="alternate" hreflang="ja" href="https://propel-lab.co.jp/" />
        <link rel="alternate" hreflang="en" href="https://propel-lab.co.jp/en/" />
        <link rel="alternate" hreflang="x-default" href="https://propel-lab.co.jp/" />
      </>
    )}

    {!noindex && (
      <>
        <!-- OGP -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:site_name" content={lang === 'en' ? 'Propel-Lab LLC' : '合同会社 Propel-Lab'} />
        <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ja_JP'} />
        <meta property="og:locale:alternate" content={lang === 'en' ? 'ja_JP' : 'en_US'} />
        <meta property="og:image" content={`${Astro.site}${base.slice(1)}images/${ogImage}`} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={`${Astro.site}${base.slice(1)}images/${ogImage}`} />
        <meta name="twitter:site" content="@kenimo49" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
      </>
    )}

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": "https://propel-lab.co.jp/#org",
        "name": lang === 'en' ? "Propel-Lab LLC" : "合同会社 Propel-Lab",
        "alternateName": lang === 'en' ? ["合同会社 Propel-Lab", "プロペルラボ"] : ["Propel-Lab LLC", "プロペルラボ"],
        "url": "https://propel-lab.co.jp/",
        "email": "info@propel-lab.co.jp",
        "logo": "https://propel-lab.co.jp/images/og-image.jpg",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": lang === 'en' ? "Fukuoka" : "福岡市中央区",
          "addressRegion": lang === 'en' ? "Fukuoka" : "福岡県",
          "addressCountry": "JP",
          "streetAddress": lang === 'en' ? "Tenjin First Bldg. 7F, 4-6-28 Tenjin, Chuo-ku" : "天神4丁目6-28 天神ファーストビル7階"
        },
        "foundingDate": "2025-04-24",
        "founder": { "@id": "https://propel-lab.co.jp/#founder" },
        "description": lang === 'en'
          ? "An AI/LLM technology company based in Fukuoka, Japan. We engineer the next generation of business models through systems thinking and AI."
          : "仕組みとエンジニアリングの力で、次世代の経営モデルを構築する"
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://propel-lab.co.jp/#website",
        "name": lang === 'en' ? "Propel-Lab LLC" : "合同会社 Propel-Lab",
        "url": "https://propel-lab.co.jp/",
        "inLanguage": ["ja", "en"],
        "publisher": { "@id": "https://propel-lab.co.jp/#org" }
      },
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": "https://propel-lab.co.jp/#founder",
        "name": lang === 'en' ? "Ken Imoto" : "井本 賢",
        "alternateName": lang === 'en' ? ["井本 賢", "ken imoto"] : ["ken imoto", "Ken Imoto"],
        "jobTitle": lang === 'en' ? "Founder & CEO" : "代表社員",
        "worksFor": { "@id": "https://propel-lab.co.jp/#org" },
        "knowsAbout": lang === 'en'
          ? ["AI Agent Design", "Context Engineering", "LLM Optimization", "Claude Code", "Android Development", "Web Development", "WebRTC", "Edge Computing", "Robotics"]
          : ["AIエージェント設計", "コンテキストエンジニアリング", "LLM活用", "LLMO", "Claude Code", "Android開発", "Web開発", "WebRTC", "エッジコンピューティング", "ロボティクス"],
        "sameAs": [
          "https://linkedin.com/in/kenimo49",
          "https://qiita.com/kenimo49",
          "https://zenn.dev/kenimo49",
          "https://note.com/kenimo49",
          "https://x.com/kenimo49",
          "https://youtube.com/@Yureru-s4n",
          "https://www.amazon.co.jp/stores/author/B0GQNPRCGF",
          "https://kenimoto.dev",
          "https://kenimo49.hatenablog.com/"
        ]
      },
    ])} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-16FQPBK8YG"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-16FQPBK8YG');
    </script>

    <!-- Contact / outbound click tracking (key events: contact_click, audit_apply) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtagEvt(){ window.dataLayer.push(arguments); }
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!a) return;
        var href = a.getAttribute('href') || '';
        var auditMethod = a.getAttribute('data-audit-apply');
        if (auditMethod) {
          gtagEvt('event', 'audit_apply', {
            method: auditMethod,
            link_url: href,
            page_path: location.pathname
          });
          return; // contact_click と二重計上しない
        }
        var method = null;
        if (href.indexOf('mailto:') === 0) method = 'email';
        else if (/linkedin\.com/.test(href)) method = 'linkedin';
        else if (/(^|\/\/)(www\.)?(x\.com|twitter\.com)/.test(href)) method = 'x';
        if (!method) return;
        gtagEvt('event', 'contact_click', {
          method: method,
          link_url: href,
          link_text: (a.textContent || '').trim().slice(0, 80),
          page_path: location.pathname
        });
      }, true);
    </script>

    <!-- Google Fonts: Sora + Noto Serif JP + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Serif+JP:wght@400;500;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <slot name="head" />

    <title>{title}</title>
  </head>
  <body class="bg-cream text-charcoal antialiased">
    <slot />
    <script>
      // Scroll-triggered animations (.fade-in-up / .fade-in-left を viewport 進入時に表示)
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in-up, .fade-in-left').forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
